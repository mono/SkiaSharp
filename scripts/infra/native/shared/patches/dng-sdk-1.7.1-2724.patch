+									   dng_exif & /* exif */,
+									   uint32 parentCode,
+									   uint32 tagCode,
+									   uint32 tagType,
+									   uint32 tagCount,
+									   uint64 /* tagOffset */)
+	{
+
+	switch (tagCode)
+		{
+
+		case tcC2PAManifest:
+			{
+
+			CheckTagType (parentCode, tagCode, tagType, ttUndefined);
+
+			fC2PAManifestOffset = stream.Position ();
+			fC2PAManifestCount  = tagCount;
+
+			#if qDNGValidate
+
+			if (gVerbose)
+				{
+
