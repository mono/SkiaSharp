+	if (trimmedSize64 > kMaxEmbeddedXMPBlockSize)
+		{
+		ThrowBadFormat ("XMP block too large");
+		}
+
+	const uint32 trimmedSize = (uint32) trimmedSize64;
+
+	AutoPtr<dng_memory_block> block (host.Allocate (trimmedSize));
