+						(unsigned long long) fC2PAManifestOffset,
+						(unsigned) 			 fC2PAManifestCount);
+
+				DumpHexAscii (stream, fC2PAManifestCount);
+
+				}
+
+			#endif
+
+			break;
+
+			}
+
+		default:
+			return false;
+
+		}
+
+	return true;
+
+	}
+
