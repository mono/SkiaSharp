diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -1898,7 +1898,7 @@ config("default_warnings") {
       # want to remove this define eventually.
       "_WINSOCK_DEPRECATED_NO_WARNINGS",
     ]
-    if (!is_clang) {
+    if (!is_clang && current_os != "winuwp") {
       # TODO(thakis): Remove this once
       # https://swiftshader-review.googlesource.com/c/SwiftShader/+/57968 has
       # rolled into angle.
@@ -2298,8 +2298,10 @@ config("no_chromium_code") {
     }
     cflags += [
       "/wd4800",  # Disable warning when forcing value to bool.
-      "/wd4267",  # TODO(jschuh): size_t to int.
     ]
+    if (current_os != "winuwp") {
+      cflags += [ "/wd4267" ]  # TODO(jschuh): size_t to int.
+    }
   } else if (is_clang) {
     cflags += [ "-Wall" ]
   }
diff --git a/third_party/zlib/BUILD.gn b/third_party/zlib/BUILD.gn
--- a/third_party/zlib/BUILD.gn
+++ b/third_party/zlib/BUILD.gn
@@ -43,10 +43,12 @@ config("zlib_warnings") {
     # V8 supports building with msvc, these silence some warnings that
     # causes compilation to fail (https://crbug.com/1255096).
     cflags = [
-      "/wd4244",
       "/wd4100",
       "/wd4702",
       "/wd4127",
     ]
+    if (current_os != "winuwp") {
+      cflags += [ "/wd4244" ]
+    }
   }
 }
