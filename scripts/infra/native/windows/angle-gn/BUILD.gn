declare_args() {
  spectre_lib_root = ""
}

config("skiasharp") {
  if (is_win) {
    assert(spectre_lib_root != "", "Spectre library directory is required.")
    defines = [ "ANGLE_WINDOWS_NO_FUTEX=1" ]
    cflags = [
      "/guard:cf",
      "/GS",
    ]
    ldflags = [
      "/guard:cf",
      "/LIBPATH:${spectre_lib_root}/${current_cpu}",
    ]
  }
}
