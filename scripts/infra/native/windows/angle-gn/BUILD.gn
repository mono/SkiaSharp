declare_args() {
  spectre_lib_root = ""
}

config("skiasharp") {
  if (is_win) {
    assert(spectre_lib_root != "", "Spectre library directory is required.")
    defines = [ "ANGLE_WINDOWS_NO_FUTEX=1" ]
    cflags = [
      "/guard:cf",
      "/GS",
    ]
    if (!is_clang) {
      # Chromium only sets a Windows warning level for Clang.
      cflags += [ "/W3" ]
      # Language flags follow cflags, overriding Chromium/zlib's /wd switches.
      cflags_c = [
        "/w24244",
        "/w34267",
      ]
      # ANGLE's palette shifts are bounded but trigger C4334 on 64-bit builds.
      cflags_cc = cflags_c + [ "/wd4334" ]
    }
    ldflags = [ "/guard:cf" ]

    # The Spectre libraries are desktop CRT libraries. UWP must link the store
    # (_APP) CRT that vcvarsall selects for winuwp.
    if (current_os != "winuwp") {
      ldflags += [ "/LIBPATH:${spectre_lib_root}/${current_cpu}" ]
    }
  }
}
