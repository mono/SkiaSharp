{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mono/SkiaSharp/scripts/infra/release/schemas/finish-plan.schema.json",
  "title": "Release Finish plan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "operation", "generatedAt", "toolingSha", "input",
    "receipt", "release", "tag", "previousTag", "draft", "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "const": "finish" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "toolingSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "input": {
      "type": "object",
      "required": ["requestedVersion"],
      "properties": {
        "requestedVersion": { "type": "string" }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "skiaSharpVersion", "base", "label", "buildRevision", "sourceCommit",
        "sourceBranch", "harfBuzzSharpVersion", "packages"
      ],
      "properties": {
        "skiaSharpVersion": { "type": "string" },
        "base": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(\\.\\d+)?$" },
        "label": { "type": "string" },
        "buildRevision": {
          "type": ["string", "null"],
          "pattern": "^(?:(?:\\d{5}|\\d{8})\\.)?\\d+$|^$"
        },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceBranch": { "type": "string", "pattern": "^release/" },
        "harfBuzzSharpVersion": { "type": "string" },
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "version", "sourceCommit", "sourceBranch"],
            "properties": {
              "id": { "type": "string" },
              "version": { "type": "string" },
              "sourceCommit": { "type": "string" },
              "sourceBranch": { "type": "string" }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "required": ["raw", "numeric", "label", "releaseType", "stable", "title", "tag"],
      "properties": {
        "raw": { "type": "string" },
        "numeric": { "type": "string" },
        "label": { "type": "string" },
        "releaseType": { "type": "string" },
        "stable": { "type": "boolean" },
        "title": { "type": "string" },
        "tag": { "type": "string", "pattern": "^v" }
      }
    },
    "tag": {
      "type": "object",
      "required": ["name", "targetCommit", "existingSha", "status"],
      "properties": {
        "name": { "type": "string", "pattern": "^v" },
        "targetCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "existingSha": { "type": ["string", "null"] },
        "status": { "enum": ["done", "pending"] }
      }
    },
    "previousTag": { "type": ["string", "null"] },
    "draft": {
      "type": "object",
      "required": ["exists", "isPublished", "status"],
      "properties": {
        "exists": { "type": "boolean" },
        "isPublished": { "type": "boolean" },
        "status": { "enum": ["done", "pending"] }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
