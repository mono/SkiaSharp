<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\source\SkiaSharp.Build.targets" />

  <PropertyGroup>
    <!--
      Benchmark projects only target $(TFMCurrent) (e.g. net10.0), but they reference
      multi-targeted binding projects (SkiaSharp.csproj, HarfBuzzSharp.csproj, etc.).
      Propagate TargetFramework/TargetFrameworks as global properties during NuGet
      restore graph walking — both for direct `dotnet run` / `dotnet build` and for
      BenchmarkDotNet's out-of-process autogenerated child .csproj — so restore does
      not evaluate mobile/platform TFMs (android/ios/maccatalyst) that require workloads.
    -->
    <_GenerateRestoreGraphProjectEntryInputProperties>
      $(_GenerateRestoreGraphProjectEntryInputProperties);
      TargetFramework=$(TFMCurrent);
      TargetFrameworks=$(TFMCurrent);
    </_GenerateRestoreGraphProjectEntryInputProperties>
  </PropertyGroup>

</Project>