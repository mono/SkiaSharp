<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>SkiaSharp</PackagingGroup>
    <NativeRuntimeFamily>Linux</NativeRuntimeFamily>
    <NativeRuntimeFlavor>NoDependencies</NativeRuntimeFlavor>
    <Title>$(PackagingGroup) - Native Assets for Linux (No Dependencies)</Title>
    <PackageNotes>Compatibility package with exact-version dependencies on all Linux NoDependencies runtime packs. Excludes fontconfig (fonts must be loaded explicitly); still requires the platform C runtime.

Default Linux packs may also be restored via SkiaSharp's runtime.json, but package-owned build targets exclude their assets from deployment. Bionic currently shares the same native artifact between both flavors.</PackageNotes>
  </PropertyGroup>
  <Target Name="IncludeAdditionalTfmSpecificPackageFiles" Condition="$(TargetFramework.StartsWith('net4'))">
    <ItemGroup>
      <TfmSpecificPackageFile Include="buildTransitive\net4\SkiaSharp.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\$(PackageId).targets;build\$(NuGetShortFolderName)\$(PackageId).targets" />
    </ItemGroup>
  </Target>
</Project>
