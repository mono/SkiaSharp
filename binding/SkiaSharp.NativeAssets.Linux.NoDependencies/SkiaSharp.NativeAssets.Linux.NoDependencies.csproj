<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>SkiaSharp</PackagingGroup>
    <Title>$(PackagingGroup) - Native Assets for Linux (No Dependencies)</Title>
    <PackageNotes>This variation of the Linux native assets includes the build of libSkiaSharp.so that does not have any dependencies on third-party libraries.

The complete dependency list is:
 - libpthread.so.0
 - libdl.so.2
 - libm.so.6
 - libc.so.6
 - ld-linux-x86-64.so.2

The excluded dependencies are:
 - Fontconfig

Compatibility package. References all Linux NoDeps per-RID native asset packages.
For new projects, add this package alongside SkiaSharp to override the default Linux native assets.</PackageNotes>
  </PropertyGroup>
  <!-- Plain dependencies on all Linux NoDeps per-RID packages -->
  <ItemGroup Condition="'$(BuildingInsideVisualStudio)' != 'true'">
    <!-- glibc -->
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-x64\SkiaSharp.NativeAssets.NoDeps.runtime.linux-x64.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-x86\SkiaSharp.NativeAssets.NoDeps.runtime.linux-x86.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-arm64\SkiaSharp.NativeAssets.NoDeps.runtime.linux-arm64.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-arm\SkiaSharp.NativeAssets.NoDeps.runtime.linux-arm.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-riscv64\SkiaSharp.NativeAssets.NoDeps.runtime.linux-riscv64.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-loongarch64\SkiaSharp.NativeAssets.NoDeps.runtime.linux-loongarch64.csproj" />
    <!-- Musl -->
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-x64\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-x64.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-x86\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-x86.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-arm64\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-arm64.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-arm\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-arm.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-riscv64\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-riscv64.csproj" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-loongarch64\SkiaSharp.NativeAssets.NoDeps.runtime.linux-musl-loongarch64.csproj" />
    <!-- Bionic -->
    <PackageFile Include="..\..\output\native\bionic\x64\libSkiaSharp*.so" PackagePath="runtimes\linux-bionic-x64\native\%(Filename)%(Extension)" />
    <PackageFile Include="..\..\output\native\bionic\arm64\libSkiaSharp*.so" PackagePath="runtimes\linux-bionic-arm64\native\%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="IncludeAdditionalTfmSpecificPackageFiles">
    <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
      <TfmSpecificPackageFile Include="buildTransitive\net4\SkiaSharp.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\$(PackageId).targets" />
      <TfmSpecificPackageFile Include="buildTransitive\net4\SkiaSharp.targets" PackagePath="build\$(NuGetShortFolderName)\$(PackageId).targets" />
    </ItemGroup>
  </Target>
</Project>
