<Project>
  <PropertyGroup>
    <_SkiaSharpNativeSelectionInputs>$(IntermediateOutputPath)SkiaSharp.NativeAssets.selection.inputs</_SkiaSharpNativeSelectionInputs>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(_SkiaSharpNativeSelectionInputs)</MSBuildAllProjects>
  </PropertyGroup>

  <Target Name="_SkiaSharpPreferNoDependencies"
          BeforeTargets="ResolveLockFileCopyLocalFiles;_HandlePackageFileConflicts"
          DependsOnTargets="ResolvePackageAssets;ResolveTargetingPackAssets">
    <ItemGroup>
      <_SkiaSharpNoDependenciesAssets Include="@(NativeCopyLocalItems->WithMetadataValue('NuGetPackageId', 'SkiaSharp.NativeAssets.Linux.NoDependencies'))" />
      <_SkiaSharpNoDependenciesAssets Include="@(RuntimeTargetsCopyLocalItems->WithMetadataValue('NuGetPackageId', 'SkiaSharp.NativeAssets.Linux.NoDependencies'))" />
      <_SkiaSharpRegularNative Include="@(NativeCopyLocalItems->WithMetadataValue('NuGetPackageId', 'SkiaSharp.NativeAssets.Linux'))" />
      <_SkiaSharpRegularRuntime Include="@(RuntimeTargetsCopyLocalItems->WithMetadataValue('NuGetPackageId', 'SkiaSharp.NativeAssets.Linux'))" />
      <_SkiaSharpUnmatchedNative Include="@(_SkiaSharpRegularNative)" />
      <_SkiaSharpUnmatchedNative Remove="@(_SkiaSharpNoDependenciesAssets)"
                                 MatchOnMetadata="PathInPackage" MatchOnMetadataOptions="CaseInsensitive" />
      <_SkiaSharpUnmatchedRuntime Include="@(_SkiaSharpRegularRuntime)" />
      <_SkiaSharpUnmatchedRuntime Remove="@(_SkiaSharpNoDependenciesAssets)"
                                  MatchOnMetadata="PathInPackage" MatchOnMetadataOptions="CaseInsensitive" />
      <_SkiaSharpReplacedRegularNative Include="@(_SkiaSharpRegularNative)" Exclude="@(_SkiaSharpUnmatchedNative)" />
      <_SkiaSharpReplacedRegularRuntime Include="@(_SkiaSharpRegularRuntime)" Exclude="@(_SkiaSharpUnmatchedRuntime)" />
      <NativeCopyLocalItems Remove="@(_SkiaSharpReplacedRegularNative)" />
      <RuntimeTargetsCopyLocalItems Remove="@(_SkiaSharpReplacedRegularRuntime)" />
    </ItemGroup>
    <PropertyGroup Condition="'@(_SkiaSharpNoDependenciesAssets)' != ''">
      <PackageConflictPreferredPackages>SkiaSharp.NativeAssets.Linux.NoDependencies;$(PackageConflictPreferredPackages)</PackageConflictPreferredPackages>
    </PropertyGroup>
  </Target>

  <Target Name="_SkiaSharpRecordNativeFilterInputs"
          BeforeTargets="ResolveLockFileCopyLocalFiles;_HandlePackageFileConflicts"
          DependsOnTargets="ResolvePackageAssets">
    <WriteLinesToFile File="$(_SkiaSharpNativeSelectionInputs)"
                      Lines="SkiaSharp=$(SkiaSharpFilterRuntimeIdentifiers)%3BHarfBuzzSharp=$(HarfBuzzSharpFilterRuntimeIdentifiers)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_SkiaSharpNativeSelectionInputs)" />
    </ItemGroup>
  </Target>

  <Target Name="_SkiaSharpFilterNativePackageAssets"
          BeforeTargets="ResolveLockFileCopyLocalFiles;_HandlePackageFileConflicts"
          DependsOnTargets="_SkiaSharpPreferNoDependencies;_SkiaSharpRecordNativeFilterInputs"
          Condition="'$(RuntimeIdentifier)' == '' and (!$([System.String]::IsNullOrWhiteSpace('$(SkiaSharpFilterRuntimeIdentifiers)')) or !$([System.String]::IsNullOrWhiteSpace('$(HarfBuzzSharpFilterRuntimeIdentifiers)')))">
    <ItemGroup>
      <_SkiaSharpFilterAssets Include="@(RuntimeTargetsCopyLocalItems)"
                              Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('SkiaSharp.NativeAssets.', System.StringComparison.OrdinalIgnoreCase)) and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != ''" />
      <_SkiaSharpFilterAssets Include="@(NativeCopyLocalItems)"
                              Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('SkiaSharp.NativeAssets.', System.StringComparison.OrdinalIgnoreCase)) and '%(NativeCopyLocalItems.RuntimeIdentifier)' != ''" />
      <_HarfBuzzSharpFilterAssets Include="@(RuntimeTargetsCopyLocalItems)"
                                  Condition="$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.NuGetPackageId)').StartsWith('HarfBuzzSharp.NativeAssets.', System.StringComparison.OrdinalIgnoreCase)) and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != ''" />
      <_HarfBuzzSharpFilterAssets Include="@(NativeCopyLocalItems)"
                                  Condition="$([System.String]::Copy('%(NativeCopyLocalItems.NuGetPackageId)').StartsWith('HarfBuzzSharp.NativeAssets.', System.StringComparison.OrdinalIgnoreCase)) and '%(NativeCopyLocalItems.RuntimeIdentifier)' != ''" />
      <_SkiaSharpAvailableRids Include="@(_SkiaSharpFilterAssets->'%(RuntimeIdentifier)')" />
      <_HarfBuzzSharpAvailableRids Include="@(_HarfBuzzSharpFilterAssets->'%(RuntimeIdentifier)')" />
      <_SkiaSharpRequestedRids Include="$([MSBuild]::Unescape('$(SkiaSharpFilterRuntimeIdentifiers)'))"
                               Condition="!$([System.String]::IsNullOrWhiteSpace('$(SkiaSharpFilterRuntimeIdentifiers)'))" />
      <_HarfBuzzSharpRequestedRids Include="$([MSBuild]::Unescape('$(HarfBuzzSharpFilterRuntimeIdentifiers)'))"
                                   Condition="!$([System.String]::IsNullOrWhiteSpace('$(HarfBuzzSharpFilterRuntimeIdentifiers)'))" />
    </ItemGroup>
    <PickBestRid RuntimeGraphPath="$(RuntimeIdentifierGraphPath)"
                 TargetRid="$([System.String]::Copy('%(_SkiaSharpRequestedRids.Identity)').Trim())"
                 SupportedRids="@(_SkiaSharpAvailableRids->Distinct())"
                 Condition="'@(_SkiaSharpFilterAssets)' != '' and '@(_SkiaSharpRequestedRids)' != ''">
      <Output TaskParameter="MatchingRid" ItemName="_SkiaSharpSelectedRids" />
    </PickBestRid>
    <PickBestRid RuntimeGraphPath="$(RuntimeIdentifierGraphPath)"
                 TargetRid="$([System.String]::Copy('%(_HarfBuzzSharpRequestedRids.Identity)').Trim())"
                 SupportedRids="@(_HarfBuzzSharpAvailableRids->Distinct())"
                 Condition="'@(_HarfBuzzSharpFilterAssets)' != '' and '@(_HarfBuzzSharpRequestedRids)' != ''">
      <Output TaskParameter="MatchingRid" ItemName="_HarfBuzzSharpSelectedRids" />
    </PickBestRid>
    <ItemGroup>
      <_SkiaSharpAllowedRid Include="@(_SkiaSharpSelectedRids)">
        <RuntimeIdentifier>%(Identity)</RuntimeIdentifier>
      </_SkiaSharpAllowedRid>
      <_HarfBuzzSharpAllowedRid Include="@(_HarfBuzzSharpSelectedRids)">
        <RuntimeIdentifier>%(Identity)</RuntimeIdentifier>
      </_HarfBuzzSharpAllowedRid>
      <_SkiaSharpRejectedAssets Include="@(_SkiaSharpFilterAssets)"
                                Condition="!$([System.String]::IsNullOrWhiteSpace('$(SkiaSharpFilterRuntimeIdentifiers)'))" />
      <_SkiaSharpRejectedAssets Remove="@(_SkiaSharpAllowedRid)"
                                MatchOnMetadata="RuntimeIdentifier" MatchOnMetadataOptions="CaseInsensitive" />
      <_HarfBuzzSharpRejectedAssets Include="@(_HarfBuzzSharpFilterAssets)"
                                    Condition="!$([System.String]::IsNullOrWhiteSpace('$(HarfBuzzSharpFilterRuntimeIdentifiers)'))" />
      <_HarfBuzzSharpRejectedAssets Remove="@(_HarfBuzzSharpAllowedRid)"
                                    MatchOnMetadata="RuntimeIdentifier" MatchOnMetadataOptions="CaseInsensitive" />
      <NativeCopyLocalItems Remove="@(_SkiaSharpRejectedAssets);@(_HarfBuzzSharpRejectedAssets)" />
      <RuntimeTargetsCopyLocalItems Remove="@(_SkiaSharpRejectedAssets);@(_HarfBuzzSharpRejectedAssets)" />
    </ItemGroup>
  </Target>
</Project>
