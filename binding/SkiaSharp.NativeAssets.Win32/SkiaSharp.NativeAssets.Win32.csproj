<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks);$(WindowsTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>SkiaSharp</PackagingGroup>
    <NativeRuntimeFamily>Windows</NativeRuntimeFamily>
    <Title>$(PackagingGroup) - Native Assets for Win32</Title>
    <PackageNotes>Compatibility package with exact-version dependencies on all three Windows runtime packs. Modern RID-selected applications can reference SkiaSharp alone.</PackageNotes>
  </PropertyGroup>
  <Target Name="IncludeAdditionalTfmSpecificPackageFiles" Condition="$(TargetFramework.StartsWith('net4'))">
    <ItemGroup>
      <TfmSpecificPackageFile Include="buildTransitive\net4\SkiaSharp.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\$(PackageId).targets;build\$(NuGetShortFolderName)\$(PackageId).targets" />
    </ItemGroup>
  </Target>
</Project>
