<Project>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'SkiaSharp.NativeAssets.RuntimePack'">
    <NativeRuntimeFlavor Condition="'$(NativeRuntimeFlavor)' == ''">Default</NativeRuntimeFlavor>
    <NativeLibrary Condition="'$(NativeLibrary)' == ''">SkiaSharp</NativeLibrary>
    <BaseIntermediateOutputPath>obj\$(NativeLibrary)\$(NativeRuntimeRid)\$(NativeRuntimeFlavor)\</BaseIntermediateOutputPath>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\source\SkiaSharp.Build.props" />

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NU5100/NU5131: NuGet packaging warnings that are pre-existing and not code quality issues -->
    <NoWarn>$(NoWarn);NU5100;NU5131</NoWarn>
  </PropertyGroup>

</Project>