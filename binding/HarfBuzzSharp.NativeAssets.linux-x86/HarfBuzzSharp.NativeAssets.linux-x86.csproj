<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>HarfBuzzSharp</PackagingGroup>
    <Title>$(PackagingGroup) - Native Asset for linux-x86</Title>
    <PackageDescription>Native asset for the linux-x86 runtime identifier. Pulled in transitively by HarfBuzzSharp.NativeAssets.Linux for backward compatibility, or referenced directly when only this specific RID is needed.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <PackageFile Include="..\..\output\native\linux\x86\libHarfBuzzSharp*.so" PackagePath="runtimes\linux-x86\native\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
