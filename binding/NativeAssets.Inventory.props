<Project>
  <!-- The single inventory for desktop runtime packs, compatibility dependencies and runtime.json. -->
  <ItemDefinitionGroup>
    <SkiaSharpNativeRuntime>
      <NativeFile>libSkiaSharp.so</NativeFile>
    </SkiaSharpNativeRuntime>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Android falls back through linux-bionic to linux; Tizen may use a workload-supplied Linux graph. -->
    <SkiaSharpNativeRuntimeBoundary Include="android;android-arm;android-arm64;android-x86;android-x64;tizen;tizen-armel;tizen-x86" />
    <!-- No x86 musl artifact is built; do not substitute the glibc x86 library. -->
    <SkiaSharpNativeRuntimeBoundary Include="linux-musl-x86" />
    <SkiaSharpNativeRuntime Include="win-x86" Family="Windows" Source="windows\x86" NativeFile="libSkiaSharp.dll" FrameworkDirectory="x86" />
    <SkiaSharpNativeRuntime Include="win-x64" Family="Windows" Source="windows\x64" NativeFile="libSkiaSharp.dll" FrameworkDirectory="x64" />
    <SkiaSharpNativeRuntime Include="win-arm64" Family="Windows" Source="windows\arm64" NativeFile="libSkiaSharp.dll" FrameworkDirectory="arm64" />
    <SkiaSharpNativeRuntime Include="osx-x64" Family="macOS" Source="osx" NativeFile="libSkiaSharp.dylib" FrameworkDirectory="x64" SymbolArchitecture="x86_64" />
    <SkiaSharpNativeRuntime Include="osx-arm64" Family="macOS" Source="osx" NativeFile="libSkiaSharp.dylib" FrameworkDirectory="arm64" SymbolArchitecture="arm64" />
    <SkiaSharpNativeRuntime Include="linux-x86" Family="Linux" Source="linux\x86" NoDependenciesSource="linuxnodeps\x86" FrameworkDirectory="x86" />
    <SkiaSharpNativeRuntime Include="linux-x64" Family="Linux" Source="linux\x64" NoDependenciesSource="linuxnodeps\x64" FrameworkDirectory="x64" />
    <SkiaSharpNativeRuntime Include="linux-arm" Family="Linux" Source="linux\arm" NoDependenciesSource="linuxnodeps\arm" FrameworkDirectory="arm" />
    <SkiaSharpNativeRuntime Include="linux-arm64" Family="Linux" Source="linux\arm64" NoDependenciesSource="linuxnodeps\arm64" FrameworkDirectory="arm64" />
    <SkiaSharpNativeRuntime Include="linux-riscv64" Family="Linux" Source="linux\riscv64" NoDependenciesSource="linuxnodeps\riscv64" FrameworkDirectory="riscv64" />
    <SkiaSharpNativeRuntime Include="linux-loongarch64" Family="Linux" Source="linux\loongarch64" NoDependenciesSource="linuxnodeps\loongarch64" FrameworkDirectory="loongarch64" />
    <SkiaSharpNativeRuntime Include="linux-musl-x64" Family="Linux" Source="alpine\x64" NoDependenciesSource="alpinenodeps\x64" FrameworkDirectory="musl-x64" />
    <SkiaSharpNativeRuntime Include="linux-musl-arm" Family="Linux" Source="alpine\arm" NoDependenciesSource="alpinenodeps\arm" FrameworkDirectory="musl-arm" />
    <SkiaSharpNativeRuntime Include="linux-musl-arm64" Family="Linux" Source="alpine\arm64" NoDependenciesSource="alpinenodeps\arm64" FrameworkDirectory="musl-arm64" />
    <SkiaSharpNativeRuntime Include="linux-musl-riscv64" Family="Linux" Source="alpine\riscv64" NoDependenciesSource="alpinenodeps\riscv64" FrameworkDirectory="musl-riscv64" />
    <SkiaSharpNativeRuntime Include="linux-musl-loongarch64" Family="Linux" Source="alpine\loongarch64" NoDependenciesSource="alpinenodeps\loongarch64" FrameworkDirectory="musl-loongarch64" />
    <SkiaSharpNativeRuntime Include="linux-bionic-x64" Family="Linux" Source="bionic\x64" NoDependenciesSource="bionic\x64" FrameworkDirectory="bionic-x64" />
    <SkiaSharpNativeRuntime Include="linux-bionic-arm64" Family="Linux" Source="bionic\arm64" NoDependenciesSource="bionic\arm64" FrameworkDirectory="bionic-arm64" />
  </ItemGroup>
</Project>
