<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>SkiaSharp</PackagingGroup>
    <Title>$(PackagingGroup) - Native Assets for linux-arm (No Dependencies)</Title>
    <PackageNotes>This is the NoDependencies variant for linux-arm. The native binary has no third-party library dependencies (no Fontconfig). Only requires libc/libm/libpthread/libdl.</PackageNotes>
  </PropertyGroup>
  <ItemGroup>
    <PerRidNativeFile Include="..\..\output\native\linuxnodeps\arm\libSkiaSharp*.so" RuntimeIdentifier="linux-arm" />
  </ItemGroup>
</Project>
