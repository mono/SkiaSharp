<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>HarfBuzzSharp</PackagingGroup>
    <NativeRuntimeFamily>Linux</NativeRuntimeFamily>
    <Title>$(PackagingGroup) - Native Assets for Linux</Title>
    <PackageNotes>Compatibility package with exact-version dependencies on all glibc, musl and Bionic runtime packs. Included by HarfBuzzSharp for neutral target frameworks.</PackageNotes>
  </PropertyGroup>
  <Target Name="IncludeAdditionalTfmSpecificPackageFiles" Condition="$(TargetFramework.StartsWith('net4'))">
    <ItemGroup>
      <TfmSpecificPackageFile Include="buildTransitive\net4\HarfBuzzSharp.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\$(PackageId).targets;build\$(NuGetShortFolderName)\$(PackageId).targets" />
    </ItemGroup>
  </Target>
</Project>
