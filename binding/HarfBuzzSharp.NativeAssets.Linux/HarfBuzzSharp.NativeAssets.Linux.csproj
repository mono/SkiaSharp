<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>HarfBuzzSharp</PackagingGroup>
    <Title>$(PackagingGroup) - Native Assets for Linux</Title>
    <PackageDescription>Meta-package that pulls in every Linux runtime identifier HarfBuzzSharp ships (glibc, musl, bionic; x64, x86, arm, arm64, riscv64, loongarch64). Backward-compatible with the previous single-nupkg layout — anyone referencing this keeps getting the same union of Linux natives. Callers that only need one RID can reference the specific HarfBuzzSharp.NativeAssets.linux-* leaf directly and skip the rest (see mono/SkiaSharp#3210 for the motivation).</PackageDescription>
  </PropertyGroup>
  <ItemGroup Condition="'$(BuildingInsideVisualStudio)' != 'true'">
    <!-- glibc -->
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-x64\HarfBuzzSharp.NativeAssets.linux-x64.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-x86\HarfBuzzSharp.NativeAssets.linux-x86.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-arm64\HarfBuzzSharp.NativeAssets.linux-arm64.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-arm\HarfBuzzSharp.NativeAssets.linux-arm.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-riscv64\HarfBuzzSharp.NativeAssets.linux-riscv64.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-loongarch64\HarfBuzzSharp.NativeAssets.linux-loongarch64.csproj" />
    <!-- musl -->
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-musl-x64\HarfBuzzSharp.NativeAssets.linux-musl-x64.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-musl-x86\HarfBuzzSharp.NativeAssets.linux-musl-x86.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-musl-arm64\HarfBuzzSharp.NativeAssets.linux-musl-arm64.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-musl-arm\HarfBuzzSharp.NativeAssets.linux-musl-arm.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-musl-riscv64\HarfBuzzSharp.NativeAssets.linux-musl-riscv64.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-musl-loongarch64\HarfBuzzSharp.NativeAssets.linux-musl-loongarch64.csproj" />
    <!-- bionic -->
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-bionic-x64\HarfBuzzSharp.NativeAssets.linux-bionic-x64.csproj" />
    <ProjectReference Include="..\HarfBuzzSharp.NativeAssets.linux-bionic-arm64\HarfBuzzSharp.NativeAssets.linux-bionic-arm64.csproj" />
  </ItemGroup>
  <Target Name="IncludeAdditionalTfmSpecificPackageFiles">
    <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
      <TfmSpecificPackageFile Include="buildTransitive\net4\HarfBuzzSharp.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\$(PackageId).targets" />
    </ItemGroup>
  </Target>
</Project>
