<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TFMPrevious)-ios$(TPViOSPrevious);$(TFMCurrent)-ios$(TPViOSCurrent)</TargetFrameworks>
    <PackagingGroup>HarfBuzzSharp</PackagingGroup>
    <Title>$(PackagingGroup) - Native Assets for iOS</Title>
  </PropertyGroup>
  <ItemGroup>
    <PackageFile Include="..\..\output\native\ios\libHarfBuzzSharp.framework\**" PackagePath="runtimes\ios\native\libHarfBuzzSharp.framework" />
    <PackageFile Include="..\..\output\native\iossimulator\libHarfBuzzSharp.framework\**" PackagePath="runtimes\iossimulator\native\libHarfBuzzSharp.framework" />
    <PackageSymbolFile Include="..\..\output\native\ios\libHarfBuzzSharp\arm64.xcarchive\dSYMs\libHarfBuzzSharp.framework.dSYM\**" PackagePath="runtimes\ios\native\symbols\arm64\libHarfBuzzSharp.framework.dSYM" />
    <PackageSymbolFile Include="..\..\output\native\ios\libHarfBuzzSharp\x86_64.xcarchive\dSYMs\libHarfBuzzSharp.framework.dSYM\**" PackagePath="runtimes\ios\native\symbols\x86_64\libHarfBuzzSharp.framework.dSYM" />
    <PackageSymbolFile Include="..\..\output\native\iossimulator\libHarfBuzzSharp\arm64.xcarchive\dSYMs\libHarfBuzzSharp.framework.dSYM\**" PackagePath="runtimes\iossimulator\native\symbols\arm64\libHarfBuzzSharp.framework.dSYM" />
    <PackageSymbolFile Include="..\..\output\native\iossimulator\libHarfBuzzSharp\x86_64.xcarchive\dSYMs\libHarfBuzzSharp.framework.dSYM\**" PackagePath="runtimes\iossimulator\native\symbols\x86_64\libHarfBuzzSharp.framework.dSYM" />
  </ItemGroup>
  <Target Name="IncludeAdditionalTfmSpecificPackageFiles">
    <ItemGroup>
      <TfmSpecificPackageFile Include="buildTransitive\HarfBuzzSharp.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\$(PackageId).targets" />
    </ItemGroup>
  </Target>
</Project>