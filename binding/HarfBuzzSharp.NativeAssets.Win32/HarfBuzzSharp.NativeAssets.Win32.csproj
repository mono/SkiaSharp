<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks);$(WindowsTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>HarfBuzzSharp</PackagingGroup>
    <NativeRuntimeFamily>Windows</NativeRuntimeFamily>
    <Title>$(PackagingGroup) - Native Assets for Win32</Title>
    <PackageNotes>Compatibility package with exact-version dependencies on all three Windows runtime packs.</PackageNotes>
  </PropertyGroup>
  <Target Name="IncludeAdditionalTfmSpecificPackageFiles" Condition="$(TargetFramework.StartsWith('net4'))">
    <ItemGroup>
      <TfmSpecificPackageFile Include="buildTransitive\net4\HarfBuzzSharp.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\$(PackageId).targets;build\$(NuGetShortFolderName)\$(PackageId).targets" />
    </ItemGroup>
  </Target>
</Project>