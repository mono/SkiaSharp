<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <SkiaSharpStaticLibraryPath>$(MSBuildThisFileDirectory)libSkiaSharp.a</SkiaSharpStaticLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <SkiaSharpStaticLibrary Include="$(SkiaSharpStaticLibraryPath)\3.1.34\**\*.a" />
    <SkiaSharpStaticLibrary Include="$(SkiaSharpStaticLibraryPath)\3.1.56\**\*.a" />
    <SkiaSharpStaticLibrary Include="$(SkiaSharpStaticLibraryPath)\6.0.2\**\*.a" />
  </ItemGroup>

</Project>