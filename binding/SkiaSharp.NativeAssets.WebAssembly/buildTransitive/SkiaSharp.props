<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <SkiaSharpStaticLibraryPath>$(MSBuildThisFileDirectory)libSkiaSharp.a</SkiaSharpStaticLibraryPath>
    <!--
      Consumed by SkiaSharp.targets' _SkiaSharpCheckWasmAssetsReferenced target,
      shipped from the main SkiaSharp package. When set, the WASM-project error
      is suppressed — indicates that the WebAssembly native assets are wired up.
    -->
    <_SkiaSharpWasmAssetsReferenced>true</_SkiaSharpWasmAssetsReferenced>
  </PropertyGroup>

  <ItemGroup>
    <SkiaSharpStaticLibrary Include="$(SkiaSharpStaticLibraryPath)\**\*.a" />
  </ItemGroup>

</Project>