<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks)</TargetFrameworks>
    <PackagingGroup>SkiaSharp</PackagingGroup>
    <Title>$(PackagingGroup) - Native Asset for linux-arm</Title>
    <PackageDescription>Native asset for the linux-arm runtime identifier. Pulled in transitively by SkiaSharp.NativeAssets.Linux for backward compatibility, or referenced directly when only this specific RID is needed.</PackageDescription>
  </PropertyGroup>
  <ItemGroup>
    <PackageFile Include="..\..\output\native\linux\arm\libSkiaSharp*.so" PackagePath="runtimes\linux-arm\native\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
