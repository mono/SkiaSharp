<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(TFMPrevious)-tvos$(TPVtvOSPrevious);$(TFMCurrent)-tvos$(TPVtvOSCurrent)</TargetFrameworks>
    <PackagingGroup>SkiaSharp</PackagingGroup>
    <Title>$(PackagingGroup) - Native Assets for tvOS</Title>
    <HasNativeSymbolPackage>true</HasNativeSymbolPackage>
  </PropertyGroup>
  <ItemGroup>
    <PackageFile Include="$(NativeOutputPath)tvos\libSkiaSharp.framework\**" PackagePath="runtimes\tvos\native\libSkiaSharp.framework" />
    <PackageFile Include="$(NativeOutputPath)tvossimulator\libSkiaSharp.framework\**" PackagePath="runtimes\tvossimulator\native\libSkiaSharp.framework" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvos\libSkiaSharp.framework\libSkiaSharp" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvossimulator\libSkiaSharp.framework\libSkiaSharp" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvos\libSkiaSharp\arm64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\Contents\Info.plist" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvos\libSkiaSharp\arm64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\Contents\Resources\DWARF\libSkiaSharp" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvos\libSkiaSharp\x86_64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\Contents\Info.plist" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvos\libSkiaSharp\x86_64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\Contents\Resources\DWARF\libSkiaSharp" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvossimulator\libSkiaSharp\arm64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\Contents\Info.plist" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvossimulator\libSkiaSharp\arm64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\Contents\Resources\DWARF\libSkiaSharp" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvossimulator\libSkiaSharp\x86_64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\Contents\Info.plist" />
    <NativeSymbolRequiredFile Include="$(NativeOutputPath)tvossimulator\libSkiaSharp\x86_64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\Contents\Resources\DWARF\libSkiaSharp" />
    <NativeSymbolPackageFile Include="$(NativeOutputPath)tvos\libSkiaSharp\arm64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\**\*" RuntimeIdentifier="tvos" Architecture="arm64" SymbolPackagePath="runtimes\tvos\native\symbols\arm64\libSkiaSharp.framework.dSYM" />
    <NativeSymbolPackageFile Include="$(NativeOutputPath)tvos\libSkiaSharp\x86_64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\**\*" RuntimeIdentifier="tvos" Architecture="x86_64" SymbolPackagePath="runtimes\tvos\native\symbols\x86_64\libSkiaSharp.framework.dSYM" />
    <NativeSymbolPackageFile Include="$(NativeOutputPath)tvossimulator\libSkiaSharp\arm64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\**\*" RuntimeIdentifier="tvossimulator" Architecture="arm64" SymbolPackagePath="runtimes\tvossimulator\native\symbols\arm64\libSkiaSharp.framework.dSYM" />
    <NativeSymbolPackageFile Include="$(NativeOutputPath)tvossimulator\libSkiaSharp\x86_64.xcarchive\dSYMs\libSkiaSharp.framework.dSYM\**\*" RuntimeIdentifier="tvossimulator" Architecture="x86_64" SymbolPackagePath="runtimes\tvossimulator\native\symbols\x86_64\libSkiaSharp.framework.dSYM" />
  </ItemGroup>
  <Target Name="IncludeAdditionalTfmSpecificPackageFiles">
    <ItemGroup>
      <TfmSpecificPackageFile Include="buildTransitive\SkiaSharp.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\$(PackageId).targets" />
    </ItemGroup>
  </Target>
</Project>