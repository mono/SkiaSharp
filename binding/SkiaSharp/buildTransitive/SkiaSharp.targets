<Project>
  <Target Name="_SkiaSharpWarnMissingRuntimeIdentifier" BeforeTargets="PrepareForBuild"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'
                     and ('$(TargetPlatformIdentifier)' == '' or '$(TargetPlatformIdentifier)' == 'Windows')
                     and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe' or '$(IsTestProject)' == 'true')
                     and '$(RuntimeIdentifier)' == ''
                     and '$(SkiaSharpNativeAssetsExplicit)' != 'true'
                     and '$(ShouldIncludeNativeSkiaSharp)' != 'false'
                     and '$(DesignTimeBuild)' != 'true'">
    <Warning Code="SKNATIVE001" Text="SkiaSharp native runtime packages require a RID during restore. Set UseCurrentRuntimeIdentifier=true in the application/test project before its first restore, use dotnet build/publish -r &lt;rid&gt;, or explicitly reference the matching SkiaSharp.NativeAssets compatibility package. A no-RID managed build does not automatically deploy libSkiaSharp." />
  </Target>
</Project>
