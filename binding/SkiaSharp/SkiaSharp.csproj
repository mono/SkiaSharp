<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(AllTargetFrameworks)</TargetFrameworks>
    <RootNamespace>SkiaSharp</RootNamespace>
    <AssemblyName>SkiaSharp</AssemblyName>
    <PackagingGroup>SkiaSharp</PackagingGroup>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>

  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <DefineConstants>$(DefineConstants);USE_DELEGATES</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
    <DefineConstants>$(DefineConstants);USE_LIBRARY_IMPORT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(BuildingInsideVisualStudio)' != 'true'">
    <!-- Platform-TFM packages: these use platform-specific build systems (ABI folders, framework bundles, static linking) -->
    <ProjectReference Include="..\SkiaSharp.NativeAssets.Android\SkiaSharp.NativeAssets.Android.csproj" Condition="$(TargetFramework.Contains('-android'))" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.iOS\SkiaSharp.NativeAssets.iOS.csproj" Condition="$(TargetFramework.Contains('-ios'))" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.MacCatalyst\SkiaSharp.NativeAssets.MacCatalyst.csproj" Condition="$(TargetFramework.Contains('-maccatalyst'))" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.Tizen\SkiaSharp.NativeAssets.Tizen.csproj" Condition="$(TargetFramework.Contains('-tizen'))" />
    <ProjectReference Include="..\SkiaSharp.NativeAssets.tvOS\SkiaSharp.NativeAssets.tvOS.csproj" Condition="$(TargetFramework.Contains('-tvos'))" />
    <!-- Desktop/server native assets are now handled via runtime.json (per-RID packages). -->
    <!-- macOS TFM still needs the NativeAssets.macOS package for Xamarin.Mac/MAUI macOS targets -->
    <ProjectReference Include="..\SkiaSharp.NativeAssets.macOS\SkiaSharp.NativeAssets.macOS.csproj" Condition="$(TargetFramework.Contains('-macos'))" />
    <!-- Windows TFM still needs NativeAssets.Win32 for WinForms/WPF desktop targets -->
    <ProjectReference Include="..\SkiaSharp.NativeAssets.Win32\SkiaSharp.NativeAssets.Win32.csproj" Condition="$(TargetFramework.Contains('-windows'))" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Binding.Shared\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Generate runtime.json at pack time with the correct version -->
  <Target Name="_GenerateRuntimeJson" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_RuntimeJsonTemplate>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\runtime.json.template'))</_RuntimeJsonTemplate>
      <_RuntimeJsonContent>$(_RuntimeJsonTemplate.Replace('VERSION_PLACEHOLDER', '$(PackageVersion)'))</_RuntimeJsonContent>
      <_RuntimeJsonPath>$(IntermediateOutputPath)runtime.json</_RuntimeJsonPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(_RuntimeJsonPath)" Lines="$(_RuntimeJsonContent)" Overwrite="true" />
    <ItemGroup>
      <FileWrites Include="$(_RuntimeJsonPath)" />
      <None Include="$(_RuntimeJsonPath)" PackagePath="runtime.json" Pack="true" />
    </ItemGroup>
  </Target>

  <!-- Ship UCRI targets inside the SkiaSharp package for consumer projects -->
  <Target Name="_IncludeUcriTargets" BeforeTargets="_GetPackageFiles" Condition="!$(TargetFramework.StartsWith('net4'))">
    <ItemGroup>
      <None Include="$(MSBuildProjectDirectory)\buildTransitive\SkiaSharp.PerRid.targets" PackagePath="buildTransitive\$(NuGetShortFolderName)\SkiaSharp.PerRid.targets" Pack="true" />
    </ItemGroup>
  </Target>
</Project>