<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:items="clr-namespace:SkiaSharpSample.Controls"
        x:Class="SkiaSharpSample.Controls.GallerySampleCard"
        x:DataType="items:GalleryCardItem"
        AutomationId="{Binding Id}" IsEnabled="{Binding Supported}"
        Opacity="{Binding Opacity}" SemanticProperties.Description="{Binding Description}"
        Margin="1,1,1,4" Style="{StaticResource GalleryCardSurface}">
    <Border.GestureRecognizers>
        <TapGestureRecognizer Tapped="CardTapped" />
    </Border.GestureRecognizers>
    <VerticalStackLayout Spacing="7" Padding="15" MinimumHeightRequest="155">
        <HorizontalStackLayout Spacing="6">
            <Label Text="{Binding CategoryIcon}" FontFamily="BootstrapIcons" FontSize="17"
                   TextColor="{Binding CategoryColor}" />
            <Label Text="{Binding Category}" FontSize="11" FontAttributes="Bold"
                   TextColor="{Binding CategoryColor}" />
        </HorizontalStackLayout>
        <Label Text="{Binding Title}" FontSize="19" FontAttributes="Bold"
               Style="{StaticResource PrimaryLabel}" />
        <Label Text="{Binding Summary}" FontSize="12" MaxLines="2"
               Style="{StaticResource SecondaryLabel}" />
        <Label Text="{Binding Badge}" FontSize="12" FontAttributes="Bold"
               Style="{StaticResource AccentLabel}">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding Supported}" Value="False">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </DataTrigger>
            </Label.Triggers>
        </Label>
    </VerticalStackLayout>
</Border>
