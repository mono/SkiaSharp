<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      xmlns:items="clr-namespace:SkiaSharpSample.Controls"
      x:Class="SkiaSharpSample.Controls.CategoryFacetView"
      x:DataType="items:CategoryFacet">
    <Border x:Name="RowSurface" AutomationId="{Binding RowId}"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
            StrokeShape="RoundRectangle 8" StrokeThickness="0"
            Padding="9,5" MinimumHeightRequest="37">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup Name="CommonStates">
                <VisualState Name="Normal" />
                <VisualState Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleBackgroundLight}, Dark={StaticResource SubtleBackgroundDark}}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding Selected}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleBackgroundLight}, Dark={StaticResource SubtleBackgroundDark}}" />
                <Setter Property="Stroke" Value="{StaticResource BrandAccent}" />
                <Setter Property="StrokeThickness" Value="1" />
            </DataTrigger>
        </Border.Triggers>
        <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="6">
            <Label Text="{Binding Icon}" FontFamily="BootstrapIcons" FontSize="15"
                   TextColor="{Binding IconColor}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding Name}" FontSize="13"
                   Style="{StaticResource PrimaryLabel}" LineBreakMode="TailTruncation"
                   VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{Binding CountText}"
                   AutomationId="{Binding CountId}" FontSize="11"
                   Style="{StaticResource SecondaryLabel}" VerticalOptions="Center"
                   HorizontalOptions="End" />
        </Grid>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
        </Border.GestureRecognizers>
    </Border>
    <Button AutomationId="{Binding Id}" Text="{Binding Name}"
            SemanticProperties.Description="{Binding Description}"
            TextColor="Transparent" BackgroundColor="Transparent"
            BorderWidth="0" Padding="0" MinimumHeightRequest="37"
            Clicked="OnClicked">
        <Button.GestureRecognizers>
            <PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
        </Button.GestureRecognizers>
    </Button>
</Grid>
