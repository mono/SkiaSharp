<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:SkiaSharpSample.Controls"
             x:Class="SkiaSharpSample.Controls.TagFacetView"
             x:DataType="items:TagFacet">
    <Button Text="{Binding Display}" AutomationId="{Binding Id}"
            SemanticProperties.Description="{Binding Description}"
            Style="{StaticResource GalleryPill}" FontSize="11"
            FontFamily="{StaticResource ApiMonoFont}" Margin="0,0,3,3"
            Clicked="OnClicked">
        <Button.Triggers>
            <DataTrigger TargetType="Button" Binding="{Binding IsType}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource TypeBackgroundLight}, Dark={StaticResource TypeBackgroundDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Button" Binding="{Binding IsType}" Value="False">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource MethodBackgroundLight}, Dark={StaticResource MethodBackgroundDark}}" />
            </DataTrigger>
            <DataTrigger TargetType="Button" Binding="{Binding Selected}" Value="True">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleBackgroundLight}, Dark={StaticResource SubtleBackgroundDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                <Setter Property="BorderColor" Value="{StaticResource BrandAccent}" />
            </DataTrigger>
        </Button.Triggers>
    </Button>
</ContentView>
