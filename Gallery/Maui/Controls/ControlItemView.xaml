<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:SkiaSharpSample.Controls"
             x:Class="SkiaSharpSample.Controls.ControlItemView"
             x:DataType="items:ControlItem">
    <Border Style="{StaticResource GalleryCardSurface}" StrokeShape="RoundRectangle 10" Padding="10">
        <VerticalStackLayout Spacing="5">
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsGroup}">
                <Label Text="{Binding Label}" Style="{StaticResource PrimaryLabel}"
                       FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding Enabled, Mode=TwoWay}"
                        AutomationId="{Binding GroupId}" Toggled="GroupChanged" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsToggle}">
                <Label Text="{Binding Label}" Style="{StaticResource PrimaryLabel}"
                       FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding Toggled, Mode=TwoWay}"
                        AutomationId="{Binding ToggleId}" Toggled="ToggleChanged" />
            </Grid>
            <VerticalStackLayout Spacing="5" IsVisible="{Binding IsSlider}">
                <Label Text="{Binding DisplayValue}" AutomationId="{Binding ValueId}"
                       Style="{StaticResource PrimaryLabel}" FontSize="14" FontAttributes="Bold" />
                <Slider x:Name="Range" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding SliderValue, Mode=TwoWay}"
                        IsVisible="{Binding Adjustable}" IsEnabled="{Binding Adjustable}"
                        AutomationId="{Binding SliderId}" ValueChanged="SliderChanged" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="5" IsVisible="{Binding IsPicker}">
                <Label Text="{Binding Label}" Style="{StaticResource PrimaryLabel}"
                       FontSize="14" FontAttributes="Bold" />
                <Picker x:Name="OptionsPicker" ItemsSource="{Binding Options}"
                        SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                        AutomationId="{Binding PickerId}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                        TitleColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                        SelectedIndexChanged="PickerChanged" />
            </VerticalStackLayout>
            <Label Text="{Binding Description}" IsVisible="{Binding HasDescription}"
                   Style="{StaticResource SecondaryLabel}" FontSize="12" />
            <VerticalStackLayout Spacing="12" Padding="12,5,0,0"
                                 IsVisible="{Binding ShowChildren}"
                                 BindableLayout.ItemsSource="{Binding Children}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="items:ControlItem">
                        <items:ControlItemView />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
