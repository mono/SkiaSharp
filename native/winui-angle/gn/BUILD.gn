declare_args() {
  spectre_lib_root = ""
}

config("skiasharp") {
  if (is_win) {
    assert(spectre_lib_root != "", "SkiaSharp requires an explicit MSVC Spectre library directory.")
    if (angle_is_winappsdk) {
      # Keep angle_common and libANGLE on the same SimpleMutex implementation.
      defines = [ "ANGLE_WINDOWS_NO_FUTEX=1" ]
    }
    cflags = [
      "/guard:cf",
      "/GS",
    ]
    ldflags = [
      "/guard:cf",
      "/LIBPATH:${spectre_lib_root}/${current_cpu}",
    ]
  }
}
