UWP ARM64: re-declare VerifyVersionInfoW, reimplement VerSetConditionMask.

Without this, target_os='winuwp' + target_cpu='arm64' fails to compile
platform_helpers.cpp with C3861. x86/x64 are unaffected.

Generated against ANGLE <version>.

To refresh after an ANGLE roll:
  1. git -C externals/angle checkout -- src/common/platform_helpers.cpp
  2. re-apply the change by hand, adjusting for upstream context
  3. git -C externals/angle diff src/common/platform_helpers.cpp > body
  4. re-add this header, which step 3 overwrites

Drop this patch entirely once upstream ANGLE stops calling VerifyVersionInfo in
IsWindowsNOrGreater() — at that point it becomes a redefinition, and the apply
will fail rather than silently doing the wrong thing.
diff --git a/src/common/platform_helpers.cpp b/src/common/platform_helpers.cpp
index dd232bf..f08942c 100644
--- a/src/common/platform_helpers.cpp
+++ b/src/common/platform_helpers.cpp
@@ -16,6 +16,56 @@
 #    include <windows.h>
 #endif
 
+// ANGLE_UWP_ARM64_VERSION_HELPERS
+//
+// On ARM64 the Windows SDK declares VerSetConditionMask / VerifyVersionInfoW
+// only for the desktop partition, so under WINAPI_FAMILY_PC_APP they are
+// invisible here and this file fails to compile with C3861. x86/x64 compile the
+// exact same call - the declarations just survive the partition guards there.
+//
+// This is compile-time visibility, not availability: VerifyVersionInfoW is
+// reachable from the app partition via the api-ms-win-core-kernel32-legacy API
+// set, which is what the UWP import library resolves it through. So re-declare
+// it exactly as winbase.h would, and reimplement VerSetConditionMask locally -
+// it is pure bit math over eight 3-bit slots, mirroring the inline x86/x64 SDK
+// version.
+#if defined(_M_ARM64) && defined(WINAPI_FAMILY_PARTITION) && \
+    !WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+
+#    ifndef VER_CONDITION_MASK
+#        define VER_CONDITION_MASK 0x07
+#    endif
+#    ifndef VER_NUM_BITS_PER_CONDITION_MASK
+#        define VER_NUM_BITS_PER_CONDITION_MASK 3
+#    endif
+
+extern "C" WINBASEAPI BOOL WINAPI VerifyVersionInfoW(LPOSVERSIONINFOEXW lpVersionInformation,
+                                                      DWORD dwTypeMask,
+                                                      DWORDLONG dwlConditionMask);
+
+static ULONGLONG VerSetConditionMask(ULONGLONG conditionMask, DWORD typeMask, BYTE condition)
+{
+    condition &= VER_CONDITION_MASK;
+    if (typeMask == 0 || condition == 0)
+        return conditionMask;
+
+    unsigned int slot;
+    if (typeMask & VER_PRODUCT_TYPE)          slot = 7;
+    else if (typeMask & VER_SUITENAME)        slot = 6;
+    else if (typeMask & VER_SERVICEPACKMAJOR) slot = 5;
+    else if (typeMask & VER_SERVICEPACKMINOR) slot = 4;
+    else if (typeMask & VER_PLATFORMID)       slot = 3;
+    else if (typeMask & VER_BUILDNUMBER)      slot = 2;
+    else if (typeMask & VER_MAJORVERSION)     slot = 1;
+    else if (typeMask & VER_MINORVERSION)     slot = 0;
+    else                                      return conditionMask;  // unknown field
+
+    return conditionMask |
+           (static_cast<ULONGLONG>(condition) << (slot * VER_NUM_BITS_PER_CONDITION_MASK));
+}
+
+#endif  // _M_ARM64 && !WINAPI_PARTITION_DESKTOP
+
 namespace angle
 {
 
