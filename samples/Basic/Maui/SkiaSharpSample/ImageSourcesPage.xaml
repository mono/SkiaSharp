<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkiaSharpSample.ImageSourcesPage"
             Title="Image Sources"
             AutomationId="ImageSourcesPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="SkiaSharp image sources" FontSize="24" />
            <Label Text="Native sources are borrowed. Each platform copies the pixels into its own image." />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,100,Auto,100" ColumnSpacing="16" RowSpacing="8">
                <Label Text="SKBitmapImageSource (red)" />
                <Label Text="SKImageImageSource (blue)" Grid.Column="1" />
                <Image x:Name="bitmapImage" AutomationId="BitmapSourceImage" Aspect="AspectFit" Grid.Row="1" />
                <Image x:Name="nativeImage" AutomationId="ImageSourceImage" Aspect="AspectFit" Grid.Row="1" Grid.Column="1" />
                <Label Text="SKPixmapImageSource (green)" Grid.Row="2" />
                <Label Text="SKPictureImageSource (gold)" Grid.Row="2" Grid.Column="1" />
                <Image x:Name="pixmapImage" AutomationId="PixmapSourceImage" Aspect="AspectFill" Grid.Row="3" />
                <Image x:Name="pictureImage" AutomationId="PictureSourceImage" Aspect="Fill" Grid.Row="3" Grid.Column="1" />
            </Grid>
            <Label Text="ImageButton uses the same bitmap source. Click it to replace red with magenta." />
            <ImageButton x:Name="imageButton" AutomationId="SkiaSourceImageButton" HeightRequest="80"
                         Aspect="AspectFit" Clicked="OnReplaceClicked" />
            <HorizontalStackLayout Spacing="8">
                <Button Text="Replace" AutomationId="ReplaceImageSources" Clicked="OnReplaceClicked" />
                <Button Text="Clear" AutomationId="ClearImageSources" Clicked="OnClearClicked" />
                <Button Text="Reload" AutomationId="ReloadImageSources" Clicked="OnReloadClicked" />
            </HorizontalStackLayout>
            <Label Text="Ordinary stream to Skia: the delayed stream must not replace the newer Skia source." />
            <Image x:Name="transitionImage" AutomationId="TransitionSourceImage" HeightRequest="80" Aspect="AspectFit" />
            <Button Text="Stream to Skia" AutomationId="StreamToSkia" Clicked="OnStreamToSkiaClicked" />
            <Label x:Name="statusLabel" AutomationId="ImageSourcesStatus" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
