<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:items="clr-namespace:SkiaSharpSample.Controls"
             x:Class="SkiaSharpSample.Controls.OptionMenuView"
             x:DataType="items:OptionMenuView">
    <VerticalStackLayout Spacing="5">
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="{Binding TitleText}" FontSize="14" FontAttributes="Bold"
                   Style="{StaticResource PrimaryLabel}" VerticalOptions="Center" />
            <ImageButton Grid.Column="1" AutomationId="{Binding CloseId}"
                         SemanticProperties.Description="Close menu"
                         Clicked="CloseClicked" BackgroundColor="Transparent"
                         MinimumWidthRequest="40" MinimumHeightRequest="40" Padding="10">
                <ImageButton.Source>
                    <FontImageSource Glyph="&#xf659;" FontFamily="BootstrapIcons" Size="16"
                                     Color="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </ImageButton.Source>
            </ImageButton>
        </Grid>
        <VerticalStackLayout Spacing="5" BindableLayout.ItemsSource="{Binding Options}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="items:MenuOptionItem">
                    <Button Text="{Binding Display}" AutomationId="{Binding Id}"
                            SemanticProperties.Description="{Binding Description}"
                            Style="{StaticResource GalleryRow}" Clicked="OptionClicked">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Selected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SubtleBackgroundLight}, Dark={StaticResource SubtleBackgroundDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
