<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <IsNetMacOSSupported>true</IsNetMacOSSupported>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>14.0</TargetPlatformMinVersion>
    <MauiVersion>10.0.51</MauiVersion>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>SkiaSharpSample</RootNamespace>
    <ApplicationTitle>SkiaSharp Gallery (AppKit)</ApplicationTitle>
    <ApplicationId>com.skiasharp.gallery.appkit</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../**/*.cs" Exclude="../MauiProgram.cs;../Platforms/**;../AppKit/**;../**/obj/**;../**/bin/**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <MauiXaml Include="../**/*.xaml" Exclude="../Platforms/**;../AppKit/**;../**/obj/**;../**/bin/**">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </MauiXaml>
    <MauiIcon Include="../Resources/appicon.png" IsAppIcon="true" Color="#1A237E" />
    <MauiSplashScreen Include="../Resources/skiasharplogo.png" BaseSize="256" Color="#1A237E" />
    <MauiFont Include="../Resources/bootstrap-icons.ttf" Alias="BootstrapIcons" />
    <BundleResource Include="../Resources/bootstrap-icons.ttf" Link="Fonts/bootstrap-icons.ttf" />
    <TrimmerRootDescriptor Include="../TrimmerRoots.xml" />
    <ProjectReference Include="../../Shared/SkiaSharpSample.Shared.csproj" />
    <ProjectReference Include="../../../../source/SkiaSharp.Views.Maui/SkiaSharp.Views.Maui.Controls.MacOS/SkiaSharp.Views.Maui.Controls.MacOS.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="0.1.0-preview.12.26421.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent" Version="0.1.0-preview.12.26421.1" />
  </ItemGroup>
  <Import Project="../../../../binding/IncludeNativeAssets.SkiaSharp.targets" />
  <Import Project="../../../../binding/IncludeNativeAssets.HarfBuzzSharp.targets" />
</Project>
