<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseMaui>true</UseMaui>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SkiaSharpSample</RootNamespace>
    <ApplicationTitle>SkiaSharp Gallery</ApplicationTitle>
    <ApplicationId>com.skiasharp.gallery.maui</ApplicationId>
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
    <MauiVersion>10.0.51</MauiVersion>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Maui\**\*.cs" Exclude="..\Maui\bin\**;..\Maui\obj\**;..\Maui\Platforms\**;..\Maui\MauiProgram.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiXaml Include="..\Maui\**\*.xaml" Exclude="..\Maui\bin\**;..\Maui\obj\**;..\Maui\Platforms\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiFont Include="..\Maui\Resources\bootstrap-icons.ttf" Alias="BootstrapIcons" />
    <None Include="..\Maui\Resources\bootstrap-icons.ttf" Link="Fonts\bootstrap-icons.ttf" CopyToOutputDirectory="PreserveNewest" />
    <MauiImage Include="..\Maui\Resources\skiasharplogo.png" />
    <ProjectReference Include="..\Shared\SkiaSharpSample.Shared.csproj" />
    <ProjectReference Include="..\..\..\source\SkiaSharp.Views.Maui\SkiaSharp.Views.Maui.Controls.WPF\SkiaSharp.Views.Maui.Controls.WPF.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Platforms.Windows.WPF.Essentials" Version="0.1.0-preview.12.26421.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.Maui.DevFlow.Agent.WPF" Version="0.1.0-preview.12.26421.1" />
    <AssemblyMetadata Include="Microsoft.Maui.DevFlowProject" Value="$(MSBuildProjectName)" />
    <AssemblyMetadata Include="Microsoft.Maui.DevFlowTfm" Value="$(TargetFramework)" />
  </ItemGroup>
  <Import Project="..\..\..\binding\IncludeNativeAssets.SkiaSharp.targets" />
  <Import Project="..\..\..\binding\IncludeNativeAssets.HarfBuzzSharp.targets" />
</Project>
