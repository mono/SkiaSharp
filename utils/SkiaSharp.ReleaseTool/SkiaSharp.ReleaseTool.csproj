<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Slice 0 of the Python -> C# release CLI migration (scripts/infra/release/**
    remains the production tooling until a later slice cuts over). This project
    owns only the foundation: errors/exit codes, the process runner, the Git
    repository wrapper, the pure release/version grammars, and the JSON plan
    artifacts + canonical digesting. No runtime commands are wired up yet.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>skiasharp-release</AssemblyName>
    <RootNamespace>SkiaSharp.ReleaseTool</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

</Project>
