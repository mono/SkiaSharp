{
    "profiles": {
        "SkiaSharpGenerator": {
            "commandName": "Project"
        },
        "SkiaSharpGenerator (SkiaSharp)": {
            "commandName": "Project",
            "commandLineArgs": "generate --config binding/libSkiaSharp.json --root externals/skia --output binding/SkiaSharp/Generated --verbose",
            "workingDirectory": "$(ProjectDir)..\\.."
        },
        "SkiaSharpGenerator (HarfBuzzSharp)": {
            "commandName": "Project",
            "commandLineArgs": "generate --config binding/libHarfBuzzSharp.json --root externals/skia/third_party/externals/harfbuzz --output binding/HarfBuzzSharp/Generated --verbose",
            "workingDirectory": "$(ProjectDir)..\\.."
        }
    }
}