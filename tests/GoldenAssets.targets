<Project>
  <ItemGroup>
    <_GoldenImage Include="$(GoldenRoot)/**/*.png">
      <GoldenKey>$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</GoldenKey>
    </_GoldenImage>
    <Content Include="@(_GoldenImage)" Condition="'$(EmbedGoldens)' != 'true'"
             CopyToOutputDirectory="PreserveNewest">
      <Link>Goldens/%(GoldenKey)</Link>
    </Content>
    <EmbeddedResource Include="@(_GoldenImage)" Condition="'$(EmbedGoldens)' == 'true'">
      <LogicalName>SkiaSharp.Goldens/%(GoldenKey)</LogicalName>
    </EmbeddedResource>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SkiaSharp.Tests.EmbedGoldens</_Parameter1>
      <_Parameter2>$(EmbedGoldens)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
