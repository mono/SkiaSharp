<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\source\SkiaSharp.Build.targets" />
  <Import Project="$(MSBuildThisFileDirectory)GoldenAssets.targets" Condition="'$(GoldenRoot)' != ''" />

  <!--
    Carries the GPU opt-out into hosts that never see the build agent's environment: the Android,
    iOS, Mac Catalyst and WASM test apps run on a device, emulator or browser. GpuPolicy reads the
    runtime configuration through AppContext when the host preserves it, with assembly metadata as
    the portable fallback for packaged mobile applications.

    Set it with the cake `skipGpu` argument or directly as `-p:SkiaSharpTestSkipGpu=graphite-dawn`.

    No `Trim` metadata: ILLink treats a trimmable RuntimeHostConfigurationOption as a feature switch
    and parses its value as a bool, which this backend-id list is not.
  -->
  <ItemGroup Condition="'$(SkiaSharpTestSkipGpu)' != ''">
    <RuntimeHostConfigurationOption Include="SkiaSharp.Tests.SkipGpu"
                                    Value="$(SkiaSharpTestSkipGpu)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SkiaSharp.Tests.SkipGpu</_Parameter1>
      <_Parameter2>$(SkiaSharpTestSkipGpu)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>