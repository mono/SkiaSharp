<Project>

  <Import Project="$(MSBuildThisFileDirectory)..\source\SkiaSharp.Build.props" />

  <PropertyGroup>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <!-- Keep this paired with the native skia_use_dng_sdk/skia_use_piex build flags. -->
    <SkiaSharpDngDecoderEnabled Condition="'$(SkiaSharpDngDecoderEnabled)' == ''">true</SkiaSharpDngDecoderEnabled>
    <DefineConstants Condition="'$(SkiaSharpDngDecoderEnabled)' == 'true'">$(DefineConstants);SKIASHARP_DNG_DECODER_ENABLED</DefineConstants>
  </PropertyGroup>

  <!-- Reuse Skia's committed DNG test fixtures without copying their binary blobs into this repository. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SkiaSharp.Tests.Console' or '$(MSBuildProjectName)' == 'SkiaSharp.Tests.Devices'">
    <DngTestImage Include="$(MSBuildThisFileDirectory)..\externals\skia\resources\images\sample_1mp.dng;$(MSBuildThisFileDirectory)..\externals\skia\resources\images\sample_1mp_rotated.dng;$(MSBuildThisFileDirectory)..\externals\skia\resources\images\dng_with_preview.dng" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SkiaSharp.Tests.Console'">
    <Content Include="@(DngTestImage)" Link="Content\images\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'SkiaSharp.Tests.Devices'">
    <EmbeddedResource Include="@(DngTestImage)" Link="Content\images\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>