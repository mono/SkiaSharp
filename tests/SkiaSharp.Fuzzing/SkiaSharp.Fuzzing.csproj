<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TFMCurrent)</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SkiaSharp.Fuzzing</RootNamespace>
    <AssemblyName>SkiaSharp.Fuzzing</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DebugType>portable</DebugType>
    <SignAssembly>false</SignAssembly>
    <SkipGenerateAssemblyVersionInfo>true</SkipGenerateAssemblyVersionInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz.Common" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\binding\HarfBuzzSharp\HarfBuzzSharp.csproj" />
    <ProjectReference Include="..\..\binding\SkiaSharp.SceneGraph\SkiaSharp.SceneGraph.csproj" />
    <ProjectReference Include="..\..\binding\SkiaSharp.Skottie\SkiaSharp.Skottie.csproj" />
    <ProjectReference Include="..\..\binding\SkiaSharp.Resources\SkiaSharp.Resources.csproj" />
    <ProjectReference Include="..\..\binding\SkiaSharp\SkiaSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Content\fonts\Roboto2-Regular_NoEmbed.ttf"
             Link="seed-sources\font.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Content\images\animated-heart.gif"
             Link="seed-sources\animated-heart.gif"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Content\images\baboon.png"
             Link="seed-sources\images\baboon.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Content\images\LottieLogo1.json"
             Link="seed-sources\images\LottieLogo1.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Content\images\lottie-base64_dotnet-bot.json"
             Link="seed-sources\images\lottie-base64_dotnet-bot.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\..\binding\IncludeNativeAssets.HarfBuzzSharp.targets" />
  <Import Project="..\..\binding\IncludeNativeAssets.SkiaSharp.targets" />

</Project>
