<Project>
  <PropertyGroup>
    <PublishingVersion>3</PublishingVersion>
    <!-- Explicit symbol packages and loose PDBs are staged by the pipeline so
         transport packages never receive generated symbol packages. -->
    <AutoGenerateSymbolPackages>false</AutoGenerateSymbolPackages>
  </PropertyGroup>

  <ItemGroup>
    <Artifact Include="$(ArtifactsShippingPackagesDir)**\*.nupkg"
              Kind="Package" />
    <Artifact Include="$(ArtifactsNonShippingPackagesDir)**\*.nupkg"
              Kind="Package"
              IsShipping="false" />
  </ItemGroup>
</Project>
