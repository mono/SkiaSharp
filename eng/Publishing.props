<Project>
  <PropertyGroup>
    <PublishingVersion>3</PublishingVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stable-looking package variants remain internal build artifacts. Only the
         prerelease view is registered in BAR and eligible for channel promotion. -->
    <Artifact Include="$(ArtifactsPackagesDir)Preview\*.nupkg" Kind="Package" />
  </ItemGroup>
</Project>
