<Project>
  <PropertyGroup>
    <PublishingVersion>3</PublishingVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the signed prerelease view is registered in BAR and eligible for
         channel promotion. -->
    <Artifact Include="$(ArtifactsPackagesDir)Preview\*.nupkg" Kind="Package" />
  </ItemGroup>
</Project>
