<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>14.0</TargetPlatformMinVersion>
    <IsNetMacOSSupported>true</IsNetMacOSSupported>
    <MauiVersion>10.0.51</MauiVersion>
    <PackageId>SkiaSharp.Views.Maui.Controls.MacOS</PackageId>
    <PackagingGroup>SkiaSharp.Views.Maui.Controls.MacOS</PackagingGroup>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">macos-preview</VersionSuffix>
    <AssemblyName>SkiaSharp.Views.Maui.Controls.MacOS</AssemblyName>
    <RootNamespace>SkiaSharp.Views.Maui.Controls</RootNamespace>
    <PackageDescription>Experimental SkiaSharp MAUI controls for the native AppKit macOS backend.</PackageDescription>
    <PackageTags>skiasharp;maui;macos;appkit</PackageTags>
    <PackageReadmeFile>PACKAGE-README.md</PackageReadmeFile>
    <IsTrimmable>true</IsTrimmable>
    <SignAssembly>false</SignAssembly>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Platforms.MacOS" Version="0.1.0-preview.12.26421.1" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.51" />
    <PackageReference Include="Microsoft.Maui.Core" Version="10.0.51" />
    <ProjectReference Include="..\..\..\binding\SkiaSharp\SkiaSharp.csproj" />
    <ProjectReference Include="..\..\SkiaSharp.Views\SkiaSharp.Views\SkiaSharp.Views.csproj" />
    <ProjectReference Include="..\SkiaSharp.Views.Maui.Core\SkiaSharp.Views.Maui.Core.csproj" />
    <ProjectReference Include="..\SkiaSharp.Views.Maui.Controls\SkiaSharp.Views.Maui.Controls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>
</Project>
