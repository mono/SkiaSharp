<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>14.0</TargetPlatformMinVersion>
    <MauiVersion>10.0.41</MauiVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SignAssembly>false</SignAssembly>
    <PublishTrimmed>true</PublishTrimmed>
    <ApplicationId>org.skiasharp.maui.appkit.smoke</ApplicationId>
    <ApplicationTitle>SkiaSharp AppKit smoke</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <ProjectReference Include="..\..\SkiaSharp.Views.Maui.Controls.MacOS.csproj" />
  </ItemGroup>
  <Import Project="..\..\..\..\..\binding\IncludeNativeAssets.SkiaSharp.targets" />
</Project>
