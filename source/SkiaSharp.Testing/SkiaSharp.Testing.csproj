<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(BasicTargetFrameworks)</TargetFrameworks>
    <AssemblyName>SkiaSharp.Testing</AssemblyName>
    <RootNamespace>SkiaSharp.Testing</RootNamespace>
    <PackagingGroup>SkiaSharp.Testing</PackagingGroup>
    <Title>Image comparison testing utilities for SkiaSharp</Title>
    <PackageDescription>Image comparison and pixel tolerance utilities for testing SkiaSharp rendering. The API is experimental and may change between releases.</PackageDescription>
    <PackageTags>testing;image-comparison;pixel-comparison;golden-images</PackageTags>
    <PackageReadmeNotice>**Experimental API:** The SkiaSharp.Testing API may change between releases. This package follows the same version as SkiaSharp. To opt in, add `SKIA4001` to your consuming project's `NoWarn` property; no preview SDK or runtime is required.</PackageReadmeNotice>
    <Nullable>enable</Nullable>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <IsPackable>true</IsPackable>
    <IsShipping>true</IsShipping>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\binding\SkiaSharp\SkiaSharp.csproj" />
  </ItemGroup>
</Project>
